# Copy to .env and supply private values. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=nuvia_clone
# Retention policy is not inferred. Zero disables automatic deletion.
DATA_RETENTION_DAYS=0
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
HOST=127.0.0.1
MAIL_MODE=file
# Generate with npm run setup:local (64 hex characters).
MAIL_ENCRYPTION_KEY=
# Optional explicit DNS/TLS compatibility settings; normal defaults are preferred.
MONGODB_DNS_SERVERS=
MONGODB_TLS_MAX_VERSION=
# Real mail: MAIL_MODE=smtp and these settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional internal AI integration. pnpm setup:models creates a private shared key.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_KEY=
AI_SERVICE_TIMEOUT_MS=75000
AI_MODEL_MANIFEST_DIR=.local/models
AI_MODEL_ROOT=.local/models
AI_MAX_CONCURRENCY=1
AI_TASK_TIMEOUT_SECONDS=60
# Explicit provider selection. Local packages remain the default; no cloud fallback.
AI_PROVIDER=local
# Optional shared offline Qwen provider. One package, one persistent serial worker.
# See apps/ai-service/docs/shared-qwen.md; interfaces are disabled unless selected.
QWEN_MODEL_PACKAGE=
QWEN_CAPABILITIES=
# Optional subset of package locales for survey drafts; empty uses package locales.
QWEN_SURVEY_LOCALES=
# Optional subset of package locales for report/topic summaries.
QWEN_REPORT_LOCALES=
# Optional online provider. Keep this private; never use a VITE_ prefix.
GEMINI_API_KEY=
# Leave model names empty for documented service defaults, or set supported IDs.
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=45
# Optional existing local Python environment with the installed model runtime.
# Leave empty to use the clone's locked uv environment.
AI_PYTHON_EXECUTABLE=

# Optional Google OAuth web client. Register this exact callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty uses APP_ORIGIN + /api/v1/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Optional Stripe subscriptions. Use test keys/prices first; no paid activation without verified webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Optional team-approved informational content, returned as plain text. No legal policy is invented.
PUBLIC_TERMS_TEXT=
PUBLIC_PRIVACY_TEXT=
PUBLIC_ABOUT_TEXT=
PUBLIC_HELP_TEXT=
PUBLIC_SECURITY_TEXT=
PUBLIC_STORIES_TEXT=
PUBLIC_PRICING_TEXT=
